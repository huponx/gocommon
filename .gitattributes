# Normalize line endings: LF in the repository and in the working tree.
* text=auto eol=lf

# Shell scripts and Makefiles must keep LF (they break with CRLF).
*.sh text eol=lf
Makefile text eol=lf
Dockerfile* text eol=lf

# Binary files: never convert or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
